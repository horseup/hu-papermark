# Use a distinct database and secrets for this application. Never commit .env.
POSTGRES_PRISMA_URL=postgresql://USER:PASSWORD@postgres:5432/papermark
POSTGRES_PRISMA_URL_NON_POOLING=postgresql://USER:PASSWORD@postgres:5432/papermark
POSTGRES_PRISMA_SHADOW_URL=postgresql://USER:PASSWORD@postgres:5432/papermark_shadow
NEXTAUTH_URL=https://dealroom.horseup.de
NEXTAUTH_SECRET=
HORSEUP_TEAM_ID=horseup-dealroom
HORSEUP_ADMIN_EMAILS=rob@horseup.de,judith@horseup.de
RESEND_API_KEY=
# Must be an address on a domain verified in the existing Resend account.
HORSEUP_EMAIL_FROM=
# Notification emails use the display name "HorseUp Deal Room" with the address above.
# Optional overrides (defaults shown): investor Reply-To, quiet window, maximum wait.
# HORSEUP_INVESTOR_REPLY_TO=investors@horseup.de
# HORSEUP_NOTIFY_QUIET_MS=600000
# HORSEUP_NOTIFY_MAX_WAIT_MS=3600000
# Set to 1 to stop the in-process notification sender (rows keep queueing).
# HORSEUP_NOTIFICATIONS_DISABLED=
AWS_REGION=eu-central-1
HORSEUP_S3_BUCKET=hu-papermark-documents-143207290060-eu-central-1
# AWS credentials come from the EC2 instance role. Do not add access keys.
# Local testing only: an S3-compatible endpoint such as MinIO. Never set in production.
# HORSEUP_S3_ENDPOINT=http://localhost:9000
