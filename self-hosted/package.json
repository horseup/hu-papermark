{
  "name": "hu-papermark-self-hosted",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "next dev",
    "build": "npm run prepare:prisma && next build",
    "start": "next start",
    "prepare:prisma": "node scripts/prepare-prisma.mjs && prisma generate",
    "typecheck": "tsc --noEmit",
    "test:policy": "node --experimental-strip-types --test ../lib/horseup/rooms/access-policy.test.mjs"
  },
  "prisma": { "schema": ".generated/prisma/schema" },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1053.0",
    "@aws-sdk/s3-request-presigner": "3.1053.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "6.5.0",
    "lucide-react": "1.16.0",
    "next": "14.2.35",
    "next-auth": "4.24.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-pdf": "8.0.2",
    "resend": "6.12.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "prisma": "6.5.0",
    "typescript": "^5"
  }
}
