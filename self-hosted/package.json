{
  "name": "hu-papermark-self-hosted",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run prepare:prisma && node scripts/prepare-pdf.mjs && next build --webpack",
    "start": "next start",
    "prepare:prisma": "node scripts/prepare-prisma.mjs && prisma generate",
    "typecheck": "tsc --noEmit",
    "test:policy": "node --experimental-strip-types --test ../lib/horseup/rooms/access-policy.test.mjs"
  },
  "prisma": {
    "schema": ".generated/prisma/schema"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1053.0",
    "@aws-sdk/s3-request-presigner": "3.1053.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "6.5.0",
    "lucide-react": "1.16.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-pdf": "11.0.0",
    "resend": "6.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "6.5.0",
    "typescript": "^5"
  }
}
